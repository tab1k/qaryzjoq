# --- Django ---------------------------------------------------------------
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=замените-на-длинный-случайный-ключ
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=qaryzjoq.kz,www.qaryzjoq.kz,31.14.27.130,localhost,127.0.0.1
# со схемой, через запятую
DJANGO_CSRF_TRUSTED_ORIGINS=https://qaryzjoq.kz,https://www.qaryzjoq.kz,http://31.14.27.130:8000

# включить, когда домен заработает по https (иначе не зайти в админку)
DJANGO_USE_HTTPS=False

DJANGO_LOG_LEVEL=INFO

# --- пути внутри контейнера ------------------------------------------------
DJANGO_DB_PATH=/data/db.sqlite3
DJANGO_STATIC_ROOT=/app/src/staticfiles

# --- gunicorn --------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_PORT=8000

# --- первый суперпользователь (создаётся при старте, если задан) -----------
DJANGO_SUPERUSER_USERNAME=beka
DJANGO_SUPERUSER_EMAIL=admin@qaryzjoq.kz
DJANGO_SUPERUSER_PASSWORD=

